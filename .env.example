# Copy this file to ".env" and fill in your own values. Never commit your real .env.
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=<redacted>

# Authentication. The server has NO built-in default password or secrets:
# if ADMIN_PASSWORD is not set, no admin account is created at startup, and
# if JWT_SECRET / SESSION_SECRET are not set, random per-boot values are
# generated instead (logins stop working across restarts). Set all of these
# to your own strong values before exposing the app anywhere.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<redacted>
JWT_SECRET=<redacted>
SESSION_SECRET=<redacted>
